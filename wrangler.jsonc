// The deploy target (issue #25): Deploy-to-Cloudflare buttons and Workers Builds read the
// Wrangler config from the repository root, and the default deploy command `npm run deploy`
// (scripts/deploy.mjs) runs there — so the steward Worker's config lives here, pointing into
// the monorepo (ADR-0001 decision 2). The deploy script wraps `wrangler deploy` and stamps
// SHEPHERD_IDENTITY (account id + script name) for claim-target checks (ADR-0004).
//
// NO secrets are typed at deploy time (ADR-0004): the Durable Object generates its own signing
// secret on first boot; the first computer claims the deployment through a Cloudflare
// authorization (`shepherd connect <url>`); browsers sign in with machine-minted one-time
// links. MODEL_KEY is the one optional secret (seed the model key at deploy, or paste it in
// the workspace's Settings later). A legacy SERVER_KEY, if still set, keeps verifying.
//
// Deploy config: vars.STEWARD_MODEL (JSON: provider, modelId, baseUrl?) overrides the default
// deepseek/deepseek-flash eval baseline (ADR-0001 decision 11); vars.DAILY_BUDGET_USD is the
// daily model-spend soft cap in dollars per UTC day, default 1 (issue #28).
{
  "name": "shepherd-steward",
  "main": "apps/steward/src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  // The Pip web workspace (ADR-0002): plain HTML/CSS/JS files, no frontend build. The Worker
  // runs first for every request so /app/assets/* sits behind the same session gate as the
  // rest of /app (ADR-0004), then serves the files through the ASSETS binding.
  "assets": { "directory": "./apps/steward/ui", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [{ "name": "Steward", "class_name": "Steward" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Steward"] }]
}
