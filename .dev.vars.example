# Deploy-to-Cloudflare reads this file and prompts for every key in it, so the three secrets
# are generated during the deploy flow itself (issue #25): paste a fresh `openssl rand -hex
# 32` for each of the first two and your model API key for the third. Descriptions shown in
# the deploy form live in the root package.json under cloudflare.bindings. For local dev,
# copy this file to .dev.vars (repo root) next to the wrangler.jsonc you run against.
# See docs/deploy.md.
SERVER_KEY=generate-with-openssl-rand-hex-32
SETUP_TOKEN=generate-a-second-different-openssl-rand-hex-32
# Your model provider's API key (default provider: DeepSeek — ADR-0001 decision 11). It stays
# an encrypted secret inside your own Cloudflare account; Shepherd never proxies it.
MODEL_KEY=paste-your-model-provider-api-key
