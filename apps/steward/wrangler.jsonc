{
  "name": "shepherd-steward",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "Steward", "class_name": "Steward" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Steward"] }],
  // The steward model is deploy config (issue #6, ADR-0001 decision 11): default
  // deepseek/deepseek-flash when unset. The API key is a secret:
  //   wrangler secret put STEWARD_MODEL_API_KEY
  // (never env-var auth — the provider is built with inline auth.apiKey.resolve, spike bug 7).
  // "vars": {
  //   "STEWARD_MODEL": "{\"provider\": \"deepseek\", \"modelId\": \"deepseek-flash\"}"
  // }
}
